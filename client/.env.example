# Site build settings. VITE_ values are BUILT INTO the public JavaScript:
# never put a password, token or key here.

# Live site address (canonical URLs, sitemap, structured data). No trailing slash.
VITE_SITE_URL=https://www.rmaplastik.com

# Google Tag Manager container. GA4, Google Ads, Meta Pixel and Hotjar are set up inside GTM.
VITE_GTM_ID=

# Optional: Google Search Console "HTML tag" verification code (only the content value)
VITE_GSC_VERIFICATION=

# API base URL for production builds (empty = same domain, /api)
VITE_API_URL=

# Build-time only (not VITE_, never in the browser): where `npm run build`
# reads the published content, and the token for it
# CONTENT_API_URL=http://localhost:5000/api/content
# CONTENT_API_TOKEN=

# =====================================================================
#  Production site build. On GitHub Actions these come from the repository
#  variables (Settings > Secrets and variables > Actions > Variables), so
#  this file is only needed for a build on your own computer.
#  VITE_ values end up in the public JavaScript: no secrets here.
# =====================================================================

VITE_SITE_URL=https://www.rmaplastik.com
VITE_GTM_ID=
VITE_GSC_VERIFICATION=
# Empty when the API answers on the same domain (https://www.rmaplastik.com/api).
# With an API subdomain: https://api.rmaplastik.com/api
VITE_API_URL=

# =====================================================================
#  Production API settings on Hosting.com.tr (cPanel > Setup Node.js App).
#  Enter these as "Environment variables" of the Node.js app, or put them in
#  <application root>/.env (outside public_html, never in git).
#  Generate random values with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

NODE_ENV=production
# Passenger sets the port itself; leave PORT empty on cPanel
PORT=

# --- MongoDB Atlas (Database > Connect > Drivers) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rma-plastik?retryWrites=true&w=majority
# Optional: small connection pool for CloudLinux process limits (default 10)
MONGODB_MAX_POOL=10

# --- Security ---
# At least 32 random characters
JWT_SECRET=
# Site address first (used in e-mail links). Add https://rmaplastik.com if the
# bare domain is not redirected to www.
CLIENT_URL=https://www.rmaplastik.com
# LiteSpeed + Passenger = one proxy in front of the app
TRUST_PROXY=1

# --- E-mail (Uzman Posta) ---
SMTP_HOST=proxy.uzmanposta.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=web@rmaplastik.com
SMTP_PASS=
MAIL_FROM='"RMA Plastik" <web@rmaplastik.com>'
QUOTE_NOTIFY_TO=info@rmaplastik.com
QUOTE_CONFIRM_CUSTOMER=true

# Meeting requests (Toplantı Talebi): new requests go here; default QUOTE_NOTIFY_TO,
# then info@rmaplastik.com. See docs/meetings.md.
MEETING_NOTIFY_TO=info@rmaplastik.com
# Optional: Microsoft Teams links made automatically through Microsoft Graph
# (Azure app with the Calendars.ReadWrite application permission). Without
# these, the panel asks for a Teams link to be pasted in.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Microsoft 365 mailbox the meetings are created in (the organizer)
TEAMS_ORGANIZER=
# Reminder e-mail before confirmed meetings (customer, guests and RMA staff).
# Hours before the start (1-168, default 24); false turns reminders off.
MEETING_REMINDER_HOURS=24
MEETING_REMINDERS=true

# --- Uploaded images: outside the app and the site folder ---
# public_html/uploads is a symlink to this folder (see the deployment guide)
UPLOAD_DIR=/home/<cpanel-user>/rma-data/uploads

# --- Drawings sent with custom project briefs: PRIVATE, never inside public_html ---
# Only logged-in sales users can download them from the admin panel.
QUOTE_FILES_DIR=/home/<cpanel-user>/rma-data/quote-files

# --- Publishing with GitHub Actions ---
PUBLISH_MODE=github
# Fine-grained personal access token: only this repository, "Actions: Read and write"
PUBLISH_GITHUB_TOKEN=
PUBLISH_GITHUB_REPOSITORY=emre317/rma-plastik-website
PUBLISH_GITHUB_WORKFLOW=publish-site.yml
PUBLISH_GITHUB_REF=main
# Same values as the GitHub secrets of the same name (at least 24 characters each)
CONTENT_API_TOKEN=
PUBLISH_CALLBACK_TOKEN=
# Minutes after which a publish that never finished is marked failed (default 40)
PUBLISH_TIMEOUT_MIN=40

# --- First admin account (npm run create-admin, once; remove afterwards) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local development. For the hosting see .env.production.example and
# docs/hosting-com-tr-deployment.md. Never commit a real .env file.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rma-plastik
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins.
# The first one is also used in e-mail links (password reset, user invitations).
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind a single reverse proxy (LiteSpeed/Passenger, nginx)
TRUST_PROXY=

# Used by `npm run create-admin` (first account only; add others in the panel: Ayarlar > Kullanıcılar)
ADMIN_NAME=RMA Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail (quote notifications, customer confirmations, catalogue, offers,
# password reset and user invitations).
# Without SMTP the panel still works; passwords are then set by an admin in Kullanıcılar.
# Company mailbox (Uzman Posta): port 587 with STARTTLS (enforced), or 465 with SSL/TLS.
# Put the password only in server/.env on the server, never in git.
# Check the settings with: npm run mail-test   (add an address to also send a test mail)
SMTP_HOST=proxy.uzmanposta.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=web@rmaplastik.com
SMTP_PASS=
# Optional sender; default is "RMA Plastik" <SMTP_USER>. Keep the same address as
# SMTP_USER and wrap the value in single quotes, e.g. '"RMA Plastik" <web@rmaplastik.com>'
MAIL_FROM=
# Where new quote requests are sent (comma-separated for several recipients);
# empty = info@rmaplastik.com. Also gets a copy (Bcc) of every proforma sent.
QUOTE_NOTIFY_TO=info@rmaplastik.com
# The customer also gets a confirmation with the reference number (RMA-XXXXXX)
# in the site language. Set to false to turn it off.
QUOTE_CONFIRM_CUSTOMER=true

# Meeting requests (Toplantı Talebi): new requests go here; default QUOTE_NOTIFY_TO,
# then info@rmaplastik.com. See docs/meetings.md.
MEETING_NOTIFY_TO=
# Optional: Microsoft Teams links made automatically through Microsoft Graph
# (Azure app with the Calendars.ReadWrite application permission). Without
# these, the panel asks for a Teams link to be pasted in.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Microsoft 365 mailbox the meetings are created in (the organizer)
TEAMS_ORGANIZER=
# Reminder e-mail before confirmed meetings (customer, guests and RMA staff).
# Hours before the start (1-168, default 24); false turns reminders off.
MEETING_REMINDER_HOURS=24
MEETING_REMINDERS=true
# Taken slots on the website calendar: how many confirmed meetings may run at
# the same time (default 1), and the Microsoft 365 calendars checked for busy
# time (comma-separated; default TEAMS_ORGANIZER; needs the MS_GRAPH_* settings).
# A slot closes when every listed calendar is busy.
MEETING_MAX_PARALLEL=1
MEETING_CALENDARS=

# Uploaded images (default: server/uploads)
UPLOAD_DIR=

# Drawings sent with custom project briefs, private (default: server/private/quote-files)
QUOTE_FILES_DIR=

# Publishing (admin panel "Yayınla")
#   local  = `npm run build` in CLIENT_DIR next to the API (development default)
#   github = GitHub Actions builds and deploys (production default)
#   off    = button disabled
PUBLISH_MODE=local
# Folder of the website project for PUBLISH_MODE=local (default: ../client)
CLIENT_DIR=
# Token the site build sends to read /api/content (optional in development)
CONTENT_API_TOKEN=

# Automatic English / Arabic for content saved in the panel (docs/content-management.md):
# Anthropic API key (console.anthropic.com). Empty = no automatic translation.
ANTHROPIC_API_KEY=
# false turns automatic translation off while keeping the key
AUTO_TRANSLATE=true

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rma-plastik
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind a single reverse proxy (nginx, Render, etc.)
TRUST_PROXY=

# Used by `npm run create-admin`
ADMIN_NAME=RMA Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Quote request notification emails
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail address>,
# SMTP_PASS=<16-character Google App Password, not the normal password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender shown in the inbox, e.g. "RMA Plastik Web" <info@rmaplastik.com>
MAIL_FROM=
# Where new quote requests are sent (comma-separated for several recipients)
QUOTE_NOTIFY_TO=emreayranci007@gmail.com

# Content management (admin panel "Yayınla")
# Folder of the website project that gets rebuilt on publish (default: ../client)
CLIENT_DIR=
# Where uploaded product images are stored (default: server/uploads)
UPLOAD_DIR=

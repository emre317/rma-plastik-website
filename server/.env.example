PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rma-plastik
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind a single reverse proxy (nginx, Render, etc.)
TRUST_PROXY=

# Used by `npm run create-admin`
ADMIN_NAME=RMA Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
